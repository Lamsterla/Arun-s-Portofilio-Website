{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "^/$",
            "dest": "/api/index.php"
        },
        {
            "src": "^/api/index.php$",
            "dest": "/api/index.php"
        }
    ]
}